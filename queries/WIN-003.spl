index=detection_lab log_type="windows" earliest=-10m@m latest=-5m@m
| where isnotnull(_time) AND isnotnull(channel) AND isnotnull(event_id) AND isnotnull(host) AND isnotnull(log_type) AND isnotnull(src_ip) AND isnotnull(user) AND channel="Security" AND event_id=4625 AND match(src_ip, "^(?!-$).+") AND match(user, "^(?!-$).+")
| stats count as observed min(_time) as first_seen max(_time) as last_seen by host src_ip user
| where observed >= 10
| eval rule_id="WIN-003", attack_id="T1110.001"
