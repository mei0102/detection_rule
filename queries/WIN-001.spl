index=detection_lab log_type="windows" earliest=-10m@m latest=-5m@m
| where isnotnull(_time) AND isnotnull(channel) AND isnotnull(command_line) AND isnotnull(event_id) AND isnotnull(host) AND isnotnull(log_type) AND isnotnull(process_path) AND channel="Security" AND event_id=4688 AND match(process_path, "(?i)(^|[\\\\/])(powershell|pwsh)\\.exe$") AND match(command_line, "(?i)(^|\\s)-(e|en|enc|enco|encod|encode|encoded|encodedc|encodedco|encodedcom|encodedcomm|encodedcomma|encodedcomman|encodedcommand)\\s+\\S+")
| stats count as observed min(_time) as first_seen max(_time) as last_seen by host
| where observed >= 1
| eval rule_id="WIN-001", attack_id="T1059.001"
