index=detection_lab log_type="windows" earliest=-10m@m latest=-5m@m
| where isnotnull(_time) AND isnotnull(channel) AND isnotnull(event_id) AND isnotnull(host) AND isnotnull(log_type) AND channel="Security" AND event_id=1102
| stats count as observed min(_time) as first_seen max(_time) as last_seen by host
| where observed >= 1
| eval rule_id="WIN-002", attack_id="T1070.001"
