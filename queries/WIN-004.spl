index=detection_lab log_type="windows" earliest=-10m@m latest=-5m@m
| where isnotnull(_time) AND isnotnull(channel) AND isnotnull(event_id) AND isnotnull(host) AND isnotnull(log_type) AND isnotnull(target_sid) AND channel="Security" AND event_id=4732 AND target_sid="S-1-5-32-544"
| stats count as observed min(_time) as first_seen max(_time) as last_seen by host
| where observed >= 1
| eval rule_id="WIN-004", attack_id="T1098"
